[Desktop Entry]
Type=Application
Name=OpenRazer Mouse Tray
Comment=Show the selected OpenRazer mouse in the KDE system tray
Comment[de]=Die ausgewählte OpenRazer-Maus im KDE-Systemtray anzeigen
Exec=basilisk-v4-tray
TryExec=basilisk-v4-tray
Icon=input-mouse
Terminal=false
StartupNotify=false
OnlyShowIn=KDE;
