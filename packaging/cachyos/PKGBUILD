pkgname=basilisk-v4-tray
pkgver=0.2.0
pkgrel=1
pkgdesc='KDE tray status and settings for OpenRazer mice and receivers'
arch=('any')
url='https://github.com/ashrynsilkstone-ui/basilisk-v4-tray'
license=('LicenseRef-Unspecified')
depends=('python' 'python-dbus' 'python-openrazer' 'pyside6')
source=("$pkgname-$pkgver.tar.gz")
# build-cachyos.sh supplies the archive and its SHA-256 from the local checkout.
sha256sums=('SKIP')

package() {
    cd "$srcdir/$pkgname-$pkgver"
    sh packaging/stage.sh "$pkgdir"
}
